/* -*- mode: c++ -*-
 * ShExCParser.ypp - ShEx2 (ShExC) parser.
 *
 * Productions ported from shex.js's ShExJison.jison (itself derived from the
 * yacker grammar at http://www.w3.org/2005/01/yacker/uploads/ShEx2), which is
 * the reference grammar for the ShEx 2.1 ShExC syntax including IMPORT,
 * ABSTRACT, EXTENDS and RESTRICTS.
 */

/*** yacc/bison Declarations ***/

/* Require a modern bison */
%require "3.2"

%define parse.trace

/* start symbol */
%start shexDoc

/* write out a header file containing the token defines */
%defines

/* use newer C++ skeleton file */
%skeleton "lalr1.cc"

/* namespace to enclose parser in */
%define api.namespace {w3c_sw}

/* set the parser's class identifier */
%define api.parser.class {ShExParser}

/* keep track of the current position within the input */
%locations
%define api.location.type {w3c_sw::location}
%initial-action
{
    // initialize the initial location object
    @$.begin.filename = @$.end.filename = &driver.streamname;
    driver.yylloc = &@$;
};

/* The driver is passed by reference to the parser and to the scanner. This
 * provides a simple but effective pure interface, not relying on global
 * variables. */
%parse-param { class ShExDriver& driver }

/* verbose error messages */
%define parse.error verbose

%code requires {
#include "SWObjects.hpp"
#include "ParserCommon.hpp"
#include "ShExSchema.hpp"

namespace w3c_sw {

namespace ShEx {
    /** POD carriers for the bison %union. */
    static const int CARD_unset = -3;
    struct CardPOD { int min; int max; }; // min == CARD_unset when absent
    struct OrTailPOD { // payload of Jison's "shapeOr" production
	std::vector<const ShapeExpr*>* ands; // NULL when the tail starts with OR
	std::vector<const ShapeExpr*>* ors;  // may be NULL (empty)
    };
} // namespace ShEx

class ShExScanner;

/** The Driver class brings together the ShExParser and ShExScanner and
 * accumulates the parsed ShEx::Schema. */
class ShExDriver : public YaccDriver {
    friend class ShExParser;
    friend class ShExScanner;
protected:
    location* yylloc;

public:
    ShEx::Schema* schema; // borrowed from caller during parse

    /** Sentinel for ShExC "." (no constraint). Converted to NULL when used
     * as a TripleConstraint valueExpr, or to an empty Shape elsewhere. */
    ShEx::Shape emptyShape;

    /* scratch space for productions that accumulate through the driver */
    std::vector<const ShEx::ShapeExpr*> pendingRestricts;
    std::vector<const TTerm*> pendingExtra;

    /** When parsing an IMPORTed schema, its start declaration is ignored. */
    bool ignoreStart = false;

    /** Blank node labels are shared across an import group so that a schema
     * can reference bnode-labelled shapes of its imports. */
    TTerm::String2BNode* shexBNodeMap = NULL;
    const BNode* getBNode (std::string name) {
	return atomFactory->getBNode(name, shexBNodeMap != NULL ? shexBNodeMap : &bnodeMap);
    }

    ShExDriver (std::string baseURI, AtomFactory* atomFactory)
	: YaccDriver(baseURI, atomFactory), yylloc(NULL), schema(NULL)
    {  }

    /** Parse a ShExC document into intoSchema. Throws ParserException/
     * ParserExceptions/ShEx::StructureError on failure. */
    void parse (IStreamContext& in, ShEx::Schema* intoSchema);

    class ShExScanner* lexer;

    /* --- helpers used by the semantic actions --- */

    bool isEmptyShape (const ShEx::ShapeExpr* e) const { return e == &emptyShape; }

    /** "." becomes an empty Shape when placed in a junction, NOT or decl. */
    const ShEx::ShapeExpr* materialize (const ShEx::ShapeExpr* e) {
	return isEmptyShape(e) ? new ShEx::Shape() : e;
    }
    /** "." as a TripleConstraint valueExpr means "no constraint". */
    const ShEx::ShapeExpr* asValueExpr (const ShEx::ShapeExpr* e) {
	return isEmptyShape(e) ? NULL : e;
    }

    const ShEx::ShapeExpr* junction (bool conjunction,
				     const ShEx::ShapeExpr* first,
				     std::vector<const ShEx::ShapeExpr*>* rest) {
	if (rest == NULL || rest->empty()) {
	    delete rest;
	    return first;
	}
	ShEx::ShapeJunction* ret = conjunction
	    ? (ShEx::ShapeJunction*)new ShEx::ShapeAnd()
	    : (ShEx::ShapeJunction*)new ShEx::ShapeOr();
	ret->exprs.push_back(materialize(first));
	for (std::vector<const ShEx::ShapeExpr*>::const_iterator it = rest->begin();
	     it != rest->end(); ++it)
	    ret->exprs.push_back(materialize(*it));
	delete rest;
	return ret;
    }

    /** Assemble Jison's shapeExpression from a leading atom and an optional
     * (AND ...)+ (OR ...)* tail. */
    const ShEx::ShapeExpr* orShape (const ShEx::ShapeExpr* atom, ShEx::OrTailPOD tail) {
	if (tail.ands == NULL && tail.ors == NULL)
	    return atom;
	const ShEx::ShapeExpr* base = junction(true, atom, tail.ands);
	return junction(false, base, tail.ors);
    }

    static std::string facetKey (const ShEx::NCComponent* c);

    /** Add a facet component, rejecting duplicates as the spec requires. */
    void addFacet (ShEx::NodeConstraint* nc, ShEx::NCComponent* facet, const location& loc) {
	std::string key = facetKey(facet);
	for (std::vector<const ShEx::NCComponent*>::const_iterator it = nc->components.begin();
	     it != nc->components.end(); ++it)
	    if (facetKey(*it) == key) {
		delete facet;
		error(loc, "facet " + key + " defined multiple times");
		return;
	    }
	nc->components.push_back(facet);
    }

    /** Numeric range facets are only allowed on known numeric datatypes. */
    void checkNumericFacets (ShEx::NodeConstraint* nc, const URI* datatype, const location& loc);

    const ShEx::TripleExpr* wrapCard (const ShEx::TripleExpr* te, ShEx::CardPOD card) {
	if (card.min == ShEx::CARD_unset)
	    return te;
	return new ShEx::TripleExprCardinality(te, ShEx::Cardinality(card.min, card.max));
    }

    const URI* rdfType () { return getAbsoluteURI("http://www.w3.org/1999/02/22-rdf-syntax-ns#type"); }
    const URI* xsd (const char* local) { return getAbsoluteURI((std::string("http://www.w3.org/2001/XMLSchema#") + local).c_str()); }
};

} // namespace w3c_sw

}

%union {
    const w3c_sw::URI*				p_URI;
    const w3c_sw::TTerm*			p_TTerm;
    const w3c_sw::RDFLiteral*			p_Literal;
    std::string*				p_string;
    bool					b;
    int						i;
    const w3c_sw::ShEx::ShapeExpr*		p_SE;
    std::vector<const w3c_sw::ShEx::ShapeExpr*>* p_SEs;
    w3c_sw::ShEx::NodeConstraint*		p_NC;
    w3c_sw::ShEx::NCComponent*			p_NCC;
    w3c_sw::ShEx::PatternC*			p_Pattern;
    w3c_sw::ShEx::ValuesC*			p_Values;
    const w3c_sw::ShEx::ValueSetValue*		p_VSV;
    w3c_sw::ShEx::StemRangeValue*		p_Stem;
    std::vector<w3c_sw::ShEx::StemRangeValue::Exclusion>* p_Excls;
    const w3c_sw::ShEx::TripleExpr*		p_TE;
    std::vector<const w3c_sw::ShEx::TripleExpr*>* p_TEs;
    w3c_sw::ShEx::Shape*			p_Shape;
    w3c_sw::ShEx::SemAct*			p_SemAct;
    std::vector<w3c_sw::ShEx::SemAct>*		p_SemActs;
    w3c_sw::ShEx::Annotation*			p_Annot;
    std::vector<w3c_sw::ShEx::Annotation>*	p_Annots;
    w3c_sw::ShEx::CardPOD			p_Card;
    w3c_sw::ShEx::OrTailPOD			p_OrTail;
}

%code {
#include "ShExCScanner.hpp"

/* this "connects" the bison parser in the driver to the flex scanner class
 * object. it defines the yylex() function call to pull the next token from the
 * current lexer object of the driver context. */
#undef yylex
#define yylex driver.lexer->lexWrapper
}

%token __EOF__ 0 "end of file"

%token IT_BASE IT_PREFIX IT_IMPORT IT_start IT_EXTERNAL IT_ABSTRACT
       IT_RESTRICTS IT_EXTENDS IT_CLOSED IT_EXTRA IT_LITERAL IT_BNODE IT_IRI
       IT_NONLITERAL IT_AND IT_OR IT_NOT
       IT_MININCLUSIVE IT_MINEXCLUSIVE IT_MAXINCLUSIVE IT_MAXEXCLUSIVE
       IT_LENGTH IT_MINLENGTH IT_MAXLENGTH IT_TOTALDIGITS IT_FRACTIONDIGITS
       IT_true IT_false RDF_TYPE
       GT_EQUAL GT_ANNOT GT_LCURLEY GT_RCURLEY GT_AMP GT_PIPE GT_COMMA
       GT_LPAREN GT_RPAREN GT_LBRACKET GT_RBRACKET GT_DOLLAR GT_DTYPE
       GT_CARROT GT_DOT GT_TILDE GT_SEMI GT_TIMES GT_PLUS GT_OPT GT_MINUS
       GT_MODULO GT_AT

%token <p_URI>		IRIREF PNAME_LN PNAME_NS ATPNAME_LN ATPNAME_NS
%token <p_TTerm>	BLANK_NODE_LABEL
%token <p_string>	LANGTAG STRING_LITERAL1 STRING_LITERAL2
			STRING_LITERAL_LONG1 STRING_LITERAL_LONG2 CODE
%token <p_Literal>	INTEGER DECIMAL DOUBLE
			LANG_STRING_LITERAL1 LANG_STRING_LITERAL2
			LANG_STRING_LITERAL_LONG1 LANG_STRING_LITERAL_LONG2
%token <p_Pattern>	REGEXP
%token <p_Card>		REPEAT_RANGE

%type <p_URI> iri prefixedName datatype predicate
%type <p_TTerm> shapeExprLabel tripleExprLabel blankNode
%type <p_Literal> rdfLiteral literal numericLiteral booleanLiteral langString
%type <p_string> string
%type <b> _QIT_ABSTRACT_E_Opt _QIT_NOT_E_Opt _QsenseFlags_E_Opt _QGT_TILDE_E_Opt
%type <i> stringLength numericRange numericLength
%type <p_SE> shapeExprDeclBody shapeExpression inlineShapeExpression inlineShapeOr
	     shapeOrRef inlineShapeOrRef shapeRef
	     shapeAnd inlineShapeAnd shapeNot inlineShapeNot
	     shapeAtom shapeAtomNoRef inlineShapeAtom
	     shapeDefinition inlineShapeDefinition
	     extension extendsShapeExpression extendsShapeOr extendsShapeAnd
	     extendsShapeNot extendsShapeAtom restriction
	     _O_QshapeExpression_E_Or_QshapeRef_E_Or_QIT_EXTERNAL_E_C
%type <p_SEs> _Q_O_QIT_OR_E_S_QshapeAnd_E_C_E_Plus
	      _Q_O_QIT_OR_E_S_QshapeAnd_E_C_E_Star
	      _Q_O_QIT_AND_E_S_QshapeNot_E_C_E_Plus
	      _Q_O_QIT_AND_E_S_QshapeNot_E_C_E_Star
	      _Q_O_QIT_OR_E_S_QinlineShapeAnd_E_C_E_Star
	      _Q_O_QIT_AND_E_S_QinlineShapeNot_E_C_E_Star
	      _Q_O_QIT_OR_E_S_QextendsShapeAnd_E_C_E_Star
	      _Q_O_QIT_AND_E_S_QextendsShapeNot_E_C_E_Star
%type <p_OrTail> shapeOr _QshapeOr_E_Opt
%type <p_NC> litNodeConstraint nonLitNodeConstraint
	     litInlineNodeConstraint nonLitInlineNodeConstraint
	     _QxsFacet_E_Star _QnumericFacet_E_Plus
	     _QstringFacet_E_Star _QstringFacet_E_Plus
%type <p_NCC> xsFacet stringFacet numericFacet nonLiteralKind
%type <p_Values> valueSet _QvalueSetValue_E_Star
%type <p_VSV> valueSetValue iriRange literalRange languageRange
	      _O_QiriExclusion_E_Plus_Or_QliteralExclusion_E_Plus_Or_QlanguageExclusion_E_Plus_C
%type <p_Excls> _QiriExclusion_E_Plus _QliteralExclusion_E_Plus
		_QlanguageExclusion_E_Plus _QiriExclusion_E_Star
		_QliteralExclusion_E_Star _QlanguageExclusion_E_Star
		_O_QGT_TILDE_E_S_QiriExclusion_E_Star_C
		_Q_O_QGT_TILDE_E_S_QiriExclusion_E_Star_C_E_Opt
		_O_QGT_TILDE_E_S_QliteralExclusion_E_Star_C
		_Q_O_QGT_TILDE_E_S_QliteralExclusion_E_Star_C_E_Opt
		_O_QGT_TILDE_E_S_QlanguageExclusion_E_Star_C
		_Q_O_QGT_TILDE_E_S_QlanguageExclusion_E_Star_C_E_Opt
		iriExclusion literalExclusion languageExclusion
%type <p_TE> tripleExpression oneOfTripleExpr multiElementOneOf groupTripleExpr
	     singleElementGroup multiElementGroup unaryTripleExpr
	     tripleConstraint bracketedTripleExpr include
	     _O_QtripleConstraint_E_Or_QbracketedTripleExpr_E_C
	     _QtripleExpression_E_Opt
%type <p_TEs> _Q_O_QGT_PIPE_E_S_QgroupTripleExpr_E_C_E_Plus
	      _Q_O_QGT_SEMI_E_S_QunaryTripleExpr_E_C_E_Plus
%type <p_TTerm> _Q_O_QGT_DOLLAR_E_S_QtripleExprLabel_E_C_E_Opt
%type <p_Shape> _Q_O_Qextension_E_Or_QextraPropertySet_E_Or_QIT_CLOSED_E_C_E_Star
%type <p_Card> cardinality _Qcardinality_E_Opt
%type <p_SemAct> codeDecl
%type <p_SemActs> semanticActions _QcodeDecl_E_Star _QcodeDecl_E_Plus
%type <p_Annot> annotation
%type <p_Annots> _Qannotation_E_Star

%%

shexDoc:
    _Qdirective_E_Star _Q_O_QnotStartAction_E_Or_QstartActions_E_S_Qstatement_E_Star_C_E_Opt
;

_Qdirective_E_Star:

  | _Qdirective_E_Star directive
;

_O_QnotStartAction_E_Or_QstartActions_E_C:
    notStartAction
  | startActions
;

_Qstatement_E_Star:

  | _Qstatement_E_Star statement
;

_O_QnotStartAction_E_Or_QstartActions_E_S_Qstatement_E_Star_C:
    _O_QnotStartAction_E_Or_QstartActions_E_C _Qstatement_E_Star
;

_Q_O_QnotStartAction_E_Or_QstartActions_E_S_Qstatement_E_Star_C_E_Opt:

  | _O_QnotStartAction_E_Or_QstartActions_E_S_Qstatement_E_Star_C
;

directive:
    baseDecl
  | prefixDecl
  | importDecl
;

baseDecl:
    IT_BASE IRIREF	{
	driver.setBase($2->getLexicalValue());
    }
;

prefixDecl:
    IT_PREFIX {
	driver.ignorePrefix(true);
    } PNAME_NS {
	driver.ignorePrefix(false);
    } iri	{
	std::string prefix($3->getLexicalValue());
	driver.addPrefix(prefix.substr(0, prefix.length()-1), $5);
    }
;

importDecl:
    IT_IMPORT iri	{
	driver.schema->imports.push_back($2);
    }
;

notStartAction:
    start
  | shapeExprDecl
;

start:
    IT_start GT_EQUAL shapeAnd _Q_O_QIT_OR_E_S_QshapeAnd_E_C_E_Star	{
	const ShEx::ShapeExpr* built = driver.materialize(driver.junction(false, $3, $4));
	if (driver.ignoreStart)
	    delete built; // an IMPORTed schema's start declaration
	else if (driver.schema->start != NULL)
	    driver.error(@1, "start already defined");
	else
	    driver.schema->start = built;
    }
;

startActions:
    _QcodeDecl_E_Plus	{
	driver.schema->startActs = *$1;
	delete $1;
    }
;

_QcodeDecl_E_Plus:
    codeDecl	{
	$$ = new std::vector<ShEx::SemAct>();
	$$->push_back(*$1);
	delete $1;
    }
  | _QcodeDecl_E_Plus codeDecl	{
	$$ = $1;
	$$->push_back(*$2);
	delete $2;
    }
;

statement:
    directive
  | notStartAction
;

shapeExprDecl:
    _QIT_ABSTRACT_E_Opt shapeExprLabel _Qrestriction_E_Star shapeExprDeclBody	{
	driver.schema->addShape($2, $1, $4);
	// restrictions were queued in the driver by the restriction production
	driver.schema->decls.back()->restricts.swap(driver.pendingRestricts);
    }
;

shapeExprDeclBody:
    _O_QshapeExpression_E_Or_QshapeRef_E_Or_QIT_EXTERNAL_E_C	{ $$ = $1; }
;

_QIT_ABSTRACT_E_Opt:
    	{ $$ = false; }
  | IT_ABSTRACT	{ $$ = true; }
;

_Qrestriction_E_Star:

  | _Qrestriction_E_Star restriction	{
	driver.pendingRestricts.push_back($2);
    }
;

_O_QshapeExpression_E_Or_QshapeRef_E_Or_QIT_EXTERNAL_E_C:
    shapeExpression	{ $$ = driver.materialize($1); }
  | shapeRef	{ $$ = $1; }
  | IT_EXTERNAL	{ $$ = new ShEx::ShapeExternal(); }
;

shapeExpression:
    _QIT_NOT_E_Opt shapeAtomNoRef _QshapeOr_E_Opt	{
	const ShEx::ShapeExpr* base = $1 ? new ShEx::ShapeNot(driver.materialize($2)) : $2;
	$$ = driver.orShape(base, $3);
    }
  | IT_NOT shapeRef _QshapeOr_E_Opt	{
	$$ = driver.orShape(new ShEx::ShapeNot($2), $3);
    }
  | shapeRef shapeOr	{
	$$ = driver.orShape($1, $2);
    }
;

_QshapeOr_E_Opt:
    	{ $$.ands = NULL; $$.ors = NULL; }
  | shapeOr	{ $$ = $1; }
;

inlineShapeExpression:
    inlineShapeOr	{ $$ = $1; }
;

shapeOr:
    _Q_O_QIT_OR_E_S_QshapeAnd_E_C_E_Plus	{
	$$.ands = NULL;
	$$.ors = $1;
    }
  | _Q_O_QIT_AND_E_S_QshapeNot_E_C_E_Plus _Q_O_QIT_OR_E_S_QshapeAnd_E_C_E_Star	{
	$$.ands = $1;
	if ($2->empty()) {
	    delete $2;
	    $$.ors = NULL;
	} else
	    $$.ors = $2;
    }
;

_O_QIT_OR_E_S_QshapeAnd_E_C:
    IT_OR shapeAnd	{ $<p_SE>$ = $2; }
;

_Q_O_QIT_OR_E_S_QshapeAnd_E_C_E_Plus:
    _O_QIT_OR_E_S_QshapeAnd_E_C	{
	$$ = new std::vector<const ShEx::ShapeExpr*>();
	$$->push_back($<p_SE>1);
    }
  | _Q_O_QIT_OR_E_S_QshapeAnd_E_C_E_Plus _O_QIT_OR_E_S_QshapeAnd_E_C	{
	$$ = $1;
	$$->push_back($<p_SE>2);
    }
;

_O_QIT_AND_E_S_QshapeNot_E_C:
    IT_AND shapeNot	{ $<p_SE>$ = $2; }
;

_Q_O_QIT_AND_E_S_QshapeNot_E_C_E_Plus:
    _O_QIT_AND_E_S_QshapeNot_E_C	{
	$$ = new std::vector<const ShEx::ShapeExpr*>();
	$$->push_back($<p_SE>1);
    }
  | _Q_O_QIT_AND_E_S_QshapeNot_E_C_E_Plus _O_QIT_AND_E_S_QshapeNot_E_C	{
	$$ = $1;
	$$->push_back($<p_SE>2);
    }
;

_Q_O_QIT_OR_E_S_QshapeAnd_E_C_E_Star:
    	{ $$ = new std::vector<const ShEx::ShapeExpr*>(); }
  | _Q_O_QIT_OR_E_S_QshapeAnd_E_C_E_Star _O_QIT_OR_E_S_QshapeAnd_E_C	{
	$$ = $1;
	$$->push_back($<p_SE>2);
    }
;

inlineShapeOr:
    inlineShapeAnd _Q_O_QIT_OR_E_S_QinlineShapeAnd_E_C_E_Star	{
	$$ = driver.junction(false, $1, $2);
    }
;

_O_QIT_OR_E_S_QinlineShapeAnd_E_C:
    IT_OR inlineShapeAnd	{ $<p_SE>$ = $2; }
;

_Q_O_QIT_OR_E_S_QinlineShapeAnd_E_C_E_Star:
    	{ $$ = new std::vector<const ShEx::ShapeExpr*>(); }
  | _Q_O_QIT_OR_E_S_QinlineShapeAnd_E_C_E_Star _O_QIT_OR_E_S_QinlineShapeAnd_E_C	{
	$$ = $1;
	$$->push_back($<p_SE>2);
    }
;

shapeAnd:
    shapeNot _Q_O_QIT_AND_E_S_QshapeNot_E_C_E_Star	{
	$$ = driver.junction(true, $1, $2);
    }
;

_Q_O_QIT_AND_E_S_QshapeNot_E_C_E_Star:
    	{ $$ = new std::vector<const ShEx::ShapeExpr*>(); }
  | _Q_O_QIT_AND_E_S_QshapeNot_E_C_E_Star _O_QIT_AND_E_S_QshapeNot_E_C	{
	$$ = $1;
	$$->push_back($<p_SE>2);
    }
;

inlineShapeAnd:
    inlineShapeNot _Q_O_QIT_AND_E_S_QinlineShapeNot_E_C_E_Star	{
	$$ = driver.junction(true, $1, $2);
    }
;

_O_QIT_AND_E_S_QinlineShapeNot_E_C:
    IT_AND inlineShapeNot	{ $<p_SE>$ = $2; }
;

_Q_O_QIT_AND_E_S_QinlineShapeNot_E_C_E_Star:
    	{ $$ = new std::vector<const ShEx::ShapeExpr*>(); }
  | _Q_O_QIT_AND_E_S_QinlineShapeNot_E_C_E_Star _O_QIT_AND_E_S_QinlineShapeNot_E_C	{
	$$ = $1;
	$$->push_back($<p_SE>2);
    }
;

shapeNot:
    _QIT_NOT_E_Opt shapeAtom	{
	$$ = $1 ? new ShEx::ShapeNot(driver.materialize($2)) : $2;
    }
;

_QIT_NOT_E_Opt:
    	{ $$ = false; }
  | IT_NOT	{ $$ = true; }
;

inlineShapeNot:
    _QIT_NOT_E_Opt inlineShapeAtom	{
	$$ = $1 ? new ShEx::ShapeNot(driver.materialize($2)) : $2;
    }
;

shapeAtom:
    nonLitNodeConstraint _QshapeOrRef_E_Opt	{
	$$ = $<p_SE>2 == NULL
	    ? (const ShEx::ShapeExpr*)$1
	    : driver.junction(true, $1, new std::vector<const ShEx::ShapeExpr*>(1, $<p_SE>2));
    }
  | litNodeConstraint	{ $$ = $1; }
  | shapeOrRef _QnonLitNodeConstraint_E_Opt	{
	$$ = $<p_NC>2 == NULL
	    ? $1
	    : driver.junction(true, $1, new std::vector<const ShEx::ShapeExpr*>(1, $<p_NC>2));
    }
  | GT_LPAREN shapeExpression GT_RPAREN	{ $$ = $2; }
  | GT_DOT	{ $$ = &driver.emptyShape; }
;

_QshapeOrRef_E_Opt:
    	{ $<p_SE>$ = NULL; }
  | shapeOrRef	{ $<p_SE>$ = $1; }
;

_QnonLitNodeConstraint_E_Opt:
    	{ $<p_NC>$ = NULL; }
  | nonLitNodeConstraint	{ $<p_NC>$ = $1; }
;

shapeAtomNoRef:
    nonLitNodeConstraint _QshapeOrRef_E_Opt	{
	$$ = $<p_SE>2 == NULL
	    ? (const ShEx::ShapeExpr*)$1
	    : driver.junction(true, $1, new std::vector<const ShEx::ShapeExpr*>(1, $<p_SE>2));
    }
  | litNodeConstraint	{ $$ = $1; }
  | shapeDefinition _QnonLitNodeConstraint_E_Opt	{
	$$ = $<p_NC>2 == NULL
	    ? $1
	    : driver.junction(true, $1, new std::vector<const ShEx::ShapeExpr*>(1, $<p_NC>2));
    }
  | GT_LPAREN shapeExpression GT_RPAREN	{ $$ = $2; }
  | GT_DOT	{ $$ = &driver.emptyShape; }
;

inlineShapeAtom:
    nonLitInlineNodeConstraint _QinlineShapeOrRef_E_Opt	{
	$$ = $<p_SE>2 == NULL
	    ? (const ShEx::ShapeExpr*)$1
	    : driver.junction(true, $1, new std::vector<const ShEx::ShapeExpr*>(1, $<p_SE>2));
    }
  | litInlineNodeConstraint	{ $$ = $1; }
  | inlineShapeOrRef _QnonLitInlineNodeConstraint_E_Opt	{
	$$ = $<p_NC>2 == NULL
	    ? $1
	    : driver.junction(true, $1, new std::vector<const ShEx::ShapeExpr*>(1, $<p_NC>2));
    }
  | GT_LPAREN shapeExpression GT_RPAREN	{ $$ = $2; }
  | GT_DOT	{ $$ = &driver.emptyShape; }
;

_QinlineShapeOrRef_E_Opt:
    	{ $<p_SE>$ = NULL; }
