extension:
    _O_QIT_EXTENDS_E_Or_QGT_AMP_E_C extendsShapeExpression	{
	$$ = driver.materialize($2);
    }
;

extendsShapeExpression:
    extendsShapeOr	{ $$ = $1; }
;

extendsShapeOr:
    extendsShapeAnd _Q_O_QIT_OR_E_S_QextendsShapeAnd_E_C_E_Star	{
	$$ = driver.junction(false, $1, $2);
    }
;

_O_QIT_OR_E_S_QextendsShapeAnd_E_C:
    IT_OR extendsShapeAnd	{ $<p_SE>$ = $2; }
;

_Q_O_QIT_OR_E_S_QextendsShapeAnd_E_C_E_Star:
    	{ $$ = new std::vector<const ShEx::ShapeExpr*>(); }
  | _Q_O_QIT_OR_E_S_QextendsShapeAnd_E_C_E_Star _O_QIT_OR_E_S_QextendsShapeAnd_E_C	{
	$$ = $1;
	$$->push_back($<p_SE>2);
    }
;

extendsShapeAnd:
    extendsShapeNot _Q_O_QIT_AND_E_S_QextendsShapeNot_E_C_E_Star	{
	$$ = driver.junction(true, $1, $2);
    }
;

_O_QIT_AND_E_S_QextendsShapeNot_E_C:
    IT_AND extendsShapeNot	{ $<p_SE>$ = $2; }
;

_Q_O_QIT_AND_E_S_QextendsShapeNot_E_C_E_Star:
    	{ $$ = new std::vector<const ShEx::ShapeExpr*>(); }
  | _Q_O_QIT_AND_E_S_QextendsShapeNot_E_C_E_Star _O_QIT_AND_E_S_QextendsShapeNot_E_C	{
	$$ = $1;
	$$->push_back($<p_SE>2);
    }
;

extendsShapeNot:
    _QIT_NOT_E_Opt extendsShapeAtom	{
	$$ = $1 ? new ShEx::ShapeNot(driver.materialize($2)) : $2;
    }
;

extendsShapeAtom:
    nonLitInlineNodeConstraint inlineShapeOrRef	{
	$$ = driver.junction(true, $1, new std::vector<const ShEx::ShapeExpr*>(1, $2));
    }
  | litInlineNodeConstraint	{ $$ = $1; }
  | inlineShapeOrRef _QnonLitInlineNodeConstraint_E_Opt	{
	$$ = $<p_NC>2 == NULL
	    ? $1
	    : driver.junction(true, $1, new std::vector<const ShEx::ShapeExpr*>(1, $<p_NC>2));
    }
  | GT_LPAREN shapeExpression GT_RPAREN	{ $$ = $2; }
  | GT_DOT	{ $$ = &driver.emptyShape; }
;

_O_QIT_EXTENDS_E_Or_QGT_AMP_E_C:
    IT_EXTENDS
  | GT_AMP
;

restriction:
    _O_QIT_RESTRICTS_E_Or_QGT_MINUS_E_C shapeOrRef	{ $$ = $2; }
;

_O_QIT_RESTRICTS_E_Or_QGT_MINUS_E_C:
    IT_RESTRICTS
  | GT_MINUS
;

%%

/* Additional code */

namespace w3c_sw {

void ShExDriver::parse (IStreamContext& in, ShEx::Schema* intoSchema) {
    reset();
    schema = intoSchema;
    streamname = in.nameStr;
    clearPrefixes();
    pendingRestricts.clear();
    pendingExtra.clear();

    ShExScanner scanner(this, in.p);
    scanner.set_debug(trace_scanning);
    this->lexer = &scanner;

    ShExParser parser(*this);
    parser.set_debug_level(trace_parsing);
    parser.parse();
    checkErrors();

    // keep the prefixes for semantic-action languages (e.g. ShExMap)
    const std::map<std::string, const URI*>& ns = getNamespaceMap()->raw();
    for (std::map<std::string, const URI*>::const_iterator it = ns.begin();
	 it != ns.end(); ++it)
	intoSchema->prefixes[it->first] = it->second->getLexicalValue();
}

std::string ShExDriver::facetKey (const ShEx::NCComponent* c) {
    if (const ShEx::StrLengthC* f = dynamic_cast<const ShEx::StrLengthC*>(c))
	return f->kind == ShEx::StrLengthC::Length ? "length"
	    : f->kind == ShEx::StrLengthC::MinLength ? "minlength" : "maxlength";
    if (dynamic_cast<const ShEx::PatternC*>(c))
	return "pattern";
    if (const ShEx::NumRangeC* f = dynamic_cast<const ShEx::NumRangeC*>(c)) {
	static const char* names[] = {"mininclusive", "minexclusive", "maxinclusive", "maxexclusive"};
	return names[f->kind];
    }
    if (const ShEx::NumLengthC* f = dynamic_cast<const ShEx::NumLengthC*>(c))
	return f->kind == ShEx::NumLengthC::TotalDigits ? "totaldigits" : "fractiondigits";
    if (dynamic_cast<const ShEx::NodeKindC*>(c))
	return "nodekind";
    if (dynamic_cast<const ShEx::DatatypeC*>(c))
	return "datatype";
    return "values";
}

void ShExDriver::checkNumericFacets (ShEx::NodeConstraint* nc, const URI* datatype,
				     const location& loc) {
    // Mirror ShExJison's numericDatatypes list.
    static const char* known[] = {
	"integer", "decimal", "float", "double", "string", "boolean", "dateTime",
	"nonPositiveInteger", "negativeInteger", "long", "int", "short", "byte",
	"nonNegativeInteger", "unsignedLong", "unsignedInt", "unsignedShort",
	"unsignedByte", "positiveInteger"
    };
    for (size_t i = 0; i < sizeof(known)/sizeof(known[0]); ++i)
	if (datatype == xsd(known[i]))
	    return;
    for (std::vector<const ShEx::NCComponent*>::const_iterator it = nc->components.begin();
	 it != nc->components.end(); ++it)
	if (const ShEx::NumRangeC* f = dynamic_cast<const ShEx::NumRangeC*>(*it))
	    error(loc, "facet " + facetKey(f) + " not allowed for unknown datatype "
		  + datatype->getLexicalValue());
}

} // namespace w3c_sw

void w3c_sw::ShExParser::error (const ShExParser::location_type& l,
				const std::string& m) {
    driver.error(l, m);
}

/* END Parser */
