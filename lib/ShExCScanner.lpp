/* -*- mode: c++ -*-
 * ShExCScanner.lpp - flex scanner for ShEx2 (ShExC).
 * Token set per shex.js's ShExJison.jison lexer.
 */

%{ /*** C/C++ Declarations ***/

#include "ShExCParser.hpp"
#include "ShExCScanner.hpp"
#include <cassert>

/* import the parser's token type into a local typedef */
typedef w3c_sw::ShExParser::token token;
typedef w3c_sw::ShExParser::token_type token_type;

/* By default yylex returns int, we use token_type. Unfortunately yyterminate
 * by default returns 0, which is not of token_type. */
#define yyterminate() return token::__EOF__

/* This disables inclusion of unistd.h, which is not available under Visual C++
 * on Win32. The C++ scanner uses STL streams instead. */
#define YY_NO_UNISTD_H

%}

/*** Flex Declarations and Options ***/

/* enable c++ scanner class generation */
%option c++

/* change the name of the scanner class. results in "ShExFlexLexer" */
%option prefix="ShEx"

/* the manual says "somewhat more optimized" */
%option batch

/* enable scanner to generate debug output. disable this for release
 * versions. */
%option debug

%option nodefault
%option warn

/* no support for include files is planned */
%option noyywrap nounput

/* enables the use of start condition stacks */
%option stack

/* The following paragraph suffices to track locations accurately. Each time
 * yylex is invoked, the begin position is moved onto the end position. */
%{
#define YY_USER_ACTION  yylloc->columns(yyleng);
#define YY_FATAL_ERROR(msg) do {		\
    throw msg;   \
} while(0)
%}

HIGH_UCS		[\xC2-\xDF][\x80-\xBF]|\xE0[\xA0-\xBF][\x80-\xBF]|[\xE1-\xEC][\x80-\xBF][\x80-\xBF]|[\xE1-\xEC][\x80-\xBF][\x80-\xBF]|\xED[\x80-\x9F][\x80-\xBF]|\xEE[\x80-\xBF][\x80-\xBF]|\xEF([\x80-\xB6][\x80-\xBF]|\xB7[\x80-\x8F]|\xB7[\xB0-\xBF]|[\xB8-\xBE][\x80-\xBF]|\xBF[\x80-\xBD])|\xF0([\x90-\x9E][\x80-\xBF][\x80-\xBF]|\x9F([\x80-\xBE][\x80-\xBF]|\xBF[\x80-\xBD])|[\xA0-\xAE][\x80-\xBF][\x80-\xBF]|\xAF([\x80-\xBE][\x80-\xBF]|\xBF[\x80-\xBD])|[\xB0-\xBE][\x80-\xBF][\x80-\xBF]|\xBF([\x80-\xBE][\x80-\xBF]|\xBF[\x80-\xBD]))|\xF1([\x80-\x8E][\x80-\xBF][\x80-\xBF]|\x8F([\x80-\xBE][\x80-\xBF]|\xBF[\x80-\xBD])|[\x90-\x9E][\x80-\xBF][\x80-\xBF]|\x9F([\x80-\xBE][\x80-\xBF]|\xBF[\x80-\xBD])|[\xA0-\xAE][\x80-\xBF][\x80-\xBF]|\xAF([\x80-\xBE][\x80-\xBF]|\xBF[\x80-\xBD])|[\xB0-\xBE][\x80-\xBF][\x80-\xBF]|\xBF([\x80-\xBE][\x80-\xBF]|\xBF[\x80-\xBD]))|\xF2([\x80-\x8E][\x80-\xBF][\x80-\xBF]|\x8F([\x80-\xBE][\x80-\xBF]|\xBF[\x80-\xBD])|[\x90-\x9E][\x80-\xBF][\x80-\xBF]|\x9F([\x80-\xBE][\x80-\xBF]|\xBF[\x80-\xBD])|[\xA0-\xAE][\x80-\xBF][\x80-\xBF]|\xAF([\x80-\xBE][\x80-\xBF]|\xBF[\x80-\xBD])|[\xB0-\xBE][\x80-\xBF][\x80-\xBF]|\xBF([\x80-\xBE][\x80-\xBF]|\xBF[\x80-\xBD]))|\xF3([\x80-\x8E][\x80-\xBF][\x80-\xBF]|\x8F([\x80-\xBE][\x80-\xBF]|\xBF[\x80-\xBD])|[\x90-\x9E][\x80-\xBF][\x80-\xBF]|\x9F([\x80-\xBE][\x80-\xBF]|\xBF[\x80-\xBD])|[\xA0-\xAE][\x80-\xBF][\x80-\xBF]|\xAF([\x80-\xBE][\x80-\xBF]|\xBF[\x80-\xBD])|[\xB0-\xBE][\x80-\xBF][\x80-\xBF]|\xBF([\x80-\xBE][\x80-\xBF]|\xBF[\x80-\xBD]))|\xF4([\x80-\x8E][\x80-\xBF][\x80-\xBF]|\x8F([\x80-\xBE][\x80-\xBF]|\xBF[\x80-\xBD]))

IT_BASE			[Bb][Aa][Ss][Ee]
IT_PREFIX		[Pp][Rr][Ee][Ff][Ii][Xx]
IT_IMPORT		[Ii][Mm][Pp][Oo][Rr][Tt]
IT_start		[Ss][Tt][Aa][Rr][Tt]
IT_EXTERNAL		[Ee][Xx][Tt][Ee][Rr][Nn][Aa][Ll]
IT_ABSTRACT		[Aa][Bb][Ss][Tt][Rr][Aa][Cc][Tt]
IT_RESTRICTS		[Rr][Ee][Ss][Tt][Rr][Ii][Cc][Tt][Ss]
IT_EXTENDS		[Ee][Xx][Tt][Ee][Nn][Dd][Ss]
IT_CLOSED		[Cc][Ll][Oo][Ss][Ee][Dd]
IT_EXTRA		[Ee][Xx][Tt][Rr][Aa]
IT_LITERAL		[Ll][Ii][Tt][Ee][Rr][Aa][Ll]
IT_BNODE		[Bb][Nn][Oo][Dd][Ee]
IT_IRI			[Ii][Rr][Ii]
IT_NONLITERAL		[Nn][Oo][Nn][Ll][Ii][Tt][Ee][Rr][Aa][Ll]
IT_AND			[Aa][Nn][Dd]
IT_OR			[Oo][Rr]
IT_NOT			[Nn][Oo][Tt]
IT_MININCLUSIVE		[Mm][Ii][Nn][Ii][Nn][Cc][Ll][Uu][Ss][Ii][Vv][Ee]
IT_MINEXCLUSIVE		[Mm][Ii][Nn][Ee][Xx][Cc][Ll][Uu][Ss][Ii][Vv][Ee]
IT_MAXINCLUSIVE		[Mm][Aa][Xx][Ii][Nn][Cc][Ll][Uu][Ss][Ii][Vv][Ee]
IT_MAXEXCLUSIVE		[Mm][Aa][Xx][Ee][Xx][Cc][Ll][Uu][Ss][Ii][Vv][Ee]
IT_LENGTH		[Ll][Ee][Nn][Gg][Tt][Hh]
IT_MINLENGTH		[Mm][Ii][Nn][Ll][Ee][Nn][Gg][Tt][Hh]
IT_MAXLENGTH		[Mm][Aa][Xx][Ll][Ee][Nn][Gg][Tt][Hh]
IT_TOTALDIGITS		[Tt][Oo][Tt][Aa][Ll][Dd][Ii][Gg][Ii][Tt][Ss]
IT_FRACTIONDIGITS	[Ff][Rr][Aa][Cc][Tt][Ii][Oo][Nn][Dd][Ii][Gg][Ii][Tt][Ss]

LANGTAG			"@"([A-Za-z])+(("-"([0-9A-Za-z])+))*
INTEGER			([+-])?([0-9])+
REPEAT_RANGE		"{"({INTEGER})((","(({INTEGER})|"*")?))?"}"
DECIMAL			([+-])?([0-9])*"."([0-9])+
EXPONENT		[Ee]([+-])?([0-9])+
DOUBLE			([+-])?(([0-9])+"."([0-9])*({EXPONENT})|(".")?([0-9])+({EXPONENT}))
ECHAR			"\\"[\"\'\\bfnrt]
PN_CHARS_BASE		[A-Z]|[a-z]|\xC3[\x80-\x96]|\xC3[\x98-\xB6]|\xC3[\xB8-\xBF]|[\xC4-\xCB][\x80-\xBF]|\xCD[\xB0-\xBD]|\xCD\xBF|[\xCE-\xDF][\x80-\xBF]|\xE0[\xA0-\xBF][\x80-\xBF]|\xE1[\x80-\xBF][\x80-\xBF]|\xE2\x80[\x8C-\x8D]|\xE2(\x81[\xB0-\xBF]|[\x82-\x85][\x80-\xBF]|\x86[\x80-\x8F])|\xE2([\xB0-\xBE][\x80-\xBF]|\xBF[\x80-\xAF])|\xE3(\x80[\x81-\xBF]|[\x81-\xBF][\x80-\xBF])|[\xE4-\xEC][\x80-\xBF][\x80-\xBF]|[\xE1-\xEC][\x80-\xBF][\x80-\xBF]|\xED[\x80-\x9F][\x80-\xBF]|\xEF([\xA4-\xB6][\x80-\xBF]|\xB7[\x80-\x8F])|\xEF(\xB7[\xB0-\xBF]|[\xB8-\xBE][\x80-\xBF]|\xBF[\x80-\xBD])|\xF0[\x90-\xBF][\x80-\xBF][\x80-\xBF]|[\xF1-\xF2][\x80-\xBF][\x80-\xBF][\x80-\xBF]|\xF3[\x80-\xAF][\x80-\xBF][\x80-\xBF]
PN_CHARS_U		{PN_CHARS_BASE}|"_"
HIGH_PN_CHARS		\xC2\xB7|\xCC[\x80-\xBF]|\xCD[\x80-\xAF]|\xE2(\x80[\xB4-\xBF]|\x81\x80)
PN_CHARS		{PN_CHARS_U}|"-"|[0-9]|{HIGH_PN_CHARS}
REGEXP			"/"([^\x2F\x5C\x0A\x0D]|"\\"[nrt\\|.?*+(){}$\x2D\x5B\x5D\x5E/]|{UCHAR})+"/"[smix]*
BLANK_NODE_LABEL	"_:"({PN_CHARS_U}|[0-9])(({PN_CHARS}|".")*{PN_CHARS})?
PN_PREFIX		{PN_CHARS_BASE}(({PN_CHARS}|".")*{PN_CHARS})?
PNAME_NS		{PN_PREFIX}?":"
ATPNAME_NS		"@"{PNAME_NS}
HEX			[0-9]|[A-F]|[a-f]
PERCENT			"%"{HEX}{HEX}
UCHAR			"\\u"{HEX}{HEX}{HEX}{HEX}|"\\U"{HEX}{HEX}{HEX}{HEX}{HEX}{HEX}{HEX}{HEX}
CODE			"{"([^%\x5C]|"\\"[%\\]|{UCHAR})*"%""}"

STRING_LITERAL1		 "'"([\x00-\x09\x0B-\x0C\x0E-\x26\x28-\x5B\x5D-\x7F]|{HIGH_UCS}|{ECHAR}|{UCHAR})*"'"
STRING_LITERAL2		"\""([\x00-\x09\x0B-\x0C\x0E-\x21\x23-\x5B\x5D-\x7F]|{HIGH_UCS}|{ECHAR}|{UCHAR})*"\""
STRING_LITERAL_LONG1	      "'''"(("'"|"''")?([\x00-\x26\x28-\x5B\x5D-\x7F]|{HIGH_UCS}|{ECHAR}|{UCHAR}))*"'''"
STRING_LITERAL_LONG2	"\"\"\""(("\""|"\"\"")?([\x00-\x21\x23-\x5B\x5D-\x7F]|{HIGH_UCS}|{ECHAR}|{UCHAR}))*"\"\"\""

LANG_STRING_LITERAL1		{STRING_LITERAL1}{LANGTAG}
LANG_STRING_LITERAL2		{STRING_LITERAL2}{LANGTAG}
LANG_STRING_LITERAL_LONG1	{STRING_LITERAL_LONG1}{LANGTAG}
LANG_STRING_LITERAL_LONG2	{STRING_LITERAL_LONG2}{LANGTAG}

IRIREF			"<"([\x21\x23-\x3b\x3d\x3f-\x5b\x5d\x5fa-z\x7e-\x7F]|{HIGH_UCS}|{UCHAR})*">"
PN_LOCAL_ESC		"\\"("_"|"~"|"."|"-"|"!"|"$"|"&"|"'"|"("|")"|"*"|"+"|","|";"|"="|"/"|"?"|"#"|"@"|"%")
PLX			{PERCENT}|{PN_LOCAL_ESC}
PN_LOCAL		({PN_CHARS_U}|":"|[0-9]|{PLX})(({PN_CHARS}|"."|":"|{PLX})*({PN_CHARS}|":"|{PLX}))?
PNAME_LN		{PNAME_NS}{PN_LOCAL}
ATPNAME_LN		"@"{PNAME_LN}
LINEFEED		\r\n|\r|\n
LOW_NON_WHITE		[\x00-\x09\x0B-\x0C\x0E-\x7F]
PASSED_TOKENS		[\t ]+|"#"({LOW_NON_WHITE}|{HIGH_UCS})*
C_COMMENT		"/*"([^*]|"*"+[^*/])*"*"+"/"

%%

{LINEFEED}		{ yylloc->end.lines(1); }
{PASSED_TOKENS}		{ yylloc->step(); }
{C_COMMENT}		{
    for (size_t i = 0; i < (size_t)yyleng; ++i)
	if (yytext[i] == '\n')
	    yylloc->end.lines(1);
    yylloc->step();
}

{ATPNAME_LN}		{ yylval->p_URI = resolvePrefix(yytext+1, yylloc); return token::ATPNAME_LN; }
{ATPNAME_NS}		{ yylval->p_URI = resolvePrefix(yytext+1, yylloc); return token::ATPNAME_NS; }
{LANGTAG}		{ yylval->p_string = new std::string(yytext+1); return token::LANGTAG; }
"@"			{ return token::GT_AT; }
{PNAME_LN}		{ yylval->p_URI = resolvePrefix(yytext, yylloc); return token::PNAME_LN; }
{REPEAT_RANGE}		{ yylval->p_Card = repeatRange(yytext, yyleng); return token::REPEAT_RANGE; }
{DOUBLE}		{ return typedLiteral(yylval, token::DOUBLE); }
{DECIMAL}		{ return typedLiteral(yylval, token::DECIMAL); }
{INTEGER}		{ return typedLiteral(yylval, token::INTEGER); }
{IRIREF}		{ yylval->p_URI = unescapeAndResolveBase(yytext+1, yyleng-2, yylloc); return token::IRIREF; }
{PNAME_NS}		{ yylval->p_URI = driver->ignorePrefix() ? driver->getURI(yytext) : resolvePrefix(yytext, yylloc); return token::PNAME_NS; }
"a"			{ return token::RDF_TYPE; }
{REGEXP}		{ yylval->p_Pattern = regexPattern(yytext, yyleng, yylloc); return token::REGEXP; }
{BLANK_NODE_LABEL}	{ yylval->p_TTerm = driver->getBNode(yytext+2); return token::BLANK_NODE_LABEL; }
{CODE}			{ yylval->p_string = semActCode(yytext, yyleng, yylloc); return token::CODE; }

{LANG_STRING_LITERAL_LONG1}	{ return langString(yylval, yylloc, 3, token::LANG_STRING_LITERAL_LONG1); }
{LANG_STRING_LITERAL_LONG2}	{ return langString(yylval, yylloc, 3, token::LANG_STRING_LITERAL_LONG2); }
{LANG_STRING_LITERAL1}		{ return langString(yylval, yylloc, 1, token::LANG_STRING_LITERAL1); }
{LANG_STRING_LITERAL2}		{ return langString(yylval, yylloc, 1, token::LANG_STRING_LITERAL2); }

{STRING_LITERAL_LONG1}	{ return unescapeString(yylval, yylloc, yytext+3, yyleng-6, token::STRING_LITERAL_LONG1); }
{STRING_LITERAL_LONG2}	{ return unescapeString(yylval, yylloc, yytext+3, yyleng-6, token::STRING_LITERAL_LONG2); }
{STRING_LITERAL1}	{ return unescapeString(yylval, yylloc, yytext+1, yyleng-2, token::STRING_LITERAL1); }
{STRING_LITERAL2}	{ return unescapeString(yylval, yylloc, yytext+1, yyleng-2, token::STRING_LITERAL2); }

{IT_BASE}		{ return token::IT_BASE; }
{IT_PREFIX}		{ return token::IT_PREFIX; }
{IT_IMPORT}		{ return token::IT_IMPORT; }
{IT_start}		{ return token::IT_start; }
{IT_EXTERNAL}		{ return token::IT_EXTERNAL; }
{IT_ABSTRACT}		{ return token::IT_ABSTRACT; }
{IT_RESTRICTS}		{ return token::IT_RESTRICTS; }
{IT_EXTENDS}		{ return token::IT_EXTENDS; }
{IT_CLOSED}		{ return token::IT_CLOSED; }
{IT_EXTRA}		{ return token::IT_EXTRA; }
{IT_LITERAL}		{ return token::IT_LITERAL; }
{IT_BNODE}		{ return token::IT_BNODE; }
{IT_IRI}		{ return token::IT_IRI; }
{IT_NONLITERAL}		{ return token::IT_NONLITERAL; }
{IT_AND}		{ return token::IT_AND; }
{IT_OR}			{ return token::IT_OR; }
{IT_NOT}		{ return token::IT_NOT; }
{IT_MININCLUSIVE}	{ return token::IT_MININCLUSIVE; }
{IT_MINEXCLUSIVE}	{ return token::IT_MINEXCLUSIVE; }
{IT_MAXINCLUSIVE}	{ return token::IT_MAXINCLUSIVE; }
{IT_MAXEXCLUSIVE}	{ return token::IT_MAXEXCLUSIVE; }
{IT_LENGTH}		{ return token::IT_LENGTH; }
{IT_MINLENGTH}		{ return token::IT_MINLENGTH; }
{IT_MAXLENGTH}		{ return token::IT_MAXLENGTH; }
{IT_TOTALDIGITS}	{ return token::IT_TOTALDIGITS; }
{IT_FRACTIONDIGITS}	{ return token::IT_FRACTIONDIGITS; }
"true"			{ return token::IT_true; }
"false"			{ return token::IT_false; }
"="			{ return token::GT_EQUAL; }
"//"			{ return token::GT_ANNOT; }
"{"			{ return token::GT_LCURLEY; }
"}"			{ return token::GT_RCURLEY; }
"&"			{ return token::GT_AMP; }
"|"			{ return token::GT_PIPE; }
","			{ return token::GT_COMMA; }
"("			{ return token::GT_LPAREN; }
")"			{ return token::GT_RPAREN; }
"["			{ return token::GT_LBRACKET; }
"]"			{ return token::GT_RBRACKET; }
"$"			{ return token::GT_DOLLAR; }
"^^"			{ return token::GT_DTYPE; }
"^"			{ return token::GT_CARROT; }
"."			{ return token::GT_DOT; }
"~"			{ return token::GT_TILDE; }
";"			{ return token::GT_SEMI; }
"*"			{ return token::GT_TIMES; }
"+"			{ return token::GT_PLUS; }
"?"			{ return token::GT_OPT; }
"-"			{ return token::GT_MINUS; }
"%"			{ return token::GT_MODULO; }

<<EOF>>			{ yyterminate(); }

.			{
    std::stringstream ss;
    ss << "unexpected input '" << yytext << "'";
    driver->error(*yylloc, ss.str());
}

%%
/* END semantic actions for ShEx terminals */

/* This implementation of ShExFlexLexer::yylex() is required to fill the
 * vtable of the class ShExFlexLexer. We define the scanner's main yylex
 * function via YY_DECL to reside in the ShExScanner class instead. */

#ifdef yylex
#undef yylex
#endif

int ShExFlexLexer::yylex()
{
    std::cerr << "in ShExFlexLexer::yylex() !" << std::endl;
    return 0;
}
